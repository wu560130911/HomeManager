<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/colorSurface"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 标题 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text="添加端口转发配置"
            android:textColor="@color/neonBlue"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- 配置名称 -->
        <EditText
            android:id="@+id/et_name"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/input_background"
            android:hint="配置名称"
            android:inputType="text"
            android:maxLines="1"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="@color/colorOnBackground"
            android:textColorHint="@color/colorOnSurfaceVariant"
            android:textSize="14sp" />

        <!-- 源IP和端口 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="源IP和端口"
            android:textColor="@color/colorOnSurfaceVariant"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/et_source_ip"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:background="@drawable/input_background"
                android:hint="127.0.0.1"
                android:inputType="text"
                android:maxLines="1"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/colorOnBackground"
                android:textColorHint="@color/colorOnSurfaceVariant"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/et_source_port"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@drawable/input_background"
                android:hint="8080"
                android:inputType="number"
                android:maxLines="1"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/colorOnBackground"
                android:textColorHint="@color/colorOnSurfaceVariant"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- 目标IP和端口 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="目标IP和端口"
            android:textColor="@color/colorOnSurfaceVariant"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/et_target_ip"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:background="@drawable/input_background"
                android:hint="192.168.1.100"
                android:inputType="text"
                android:maxLines="1"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/colorOnBackground"
                android:textColorHint="@color/colorOnSurfaceVariant"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/et_target_port"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@drawable/input_background"
                android:hint="80"
                android:inputType="number"
                android:maxLines="1"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/colorOnBackground"
                android:textColorHint="@color/colorOnSurfaceVariant"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- 转发类型 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="转发类型"
            android:textColor="@color/colorOnSurfaceVariant"
            android:textSize="12sp" />

        <RadioGroup
            android:id="@+id/rg_forward_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rb_target_to_local"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:buttonTint="@color/neonBlue"
                android:text="目标转发到本地"
                android:textColor="@color/colorOnBackground"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/rb_local_to_target"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:buttonTint="@color/neonBlue"
                android:text="本地转发到目标"
                android:textColor="@color/colorOnBackground"
                android:textSize="14sp" />

        </RadioGroup>

        <!-- 按钮 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_cancel"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="@string/cancel"
                android:textSize="14sp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:backgroundTint="@color/colorSurfaceVariant"
                android:textColor="@color/colorOnBackground"
                app:cornerRadius="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_save"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="@string/confirm"
                android:textSize="14sp"
                android:textStyle="bold"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:backgroundTint="@color/neonBlue"
                app:cornerRadius="8dp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
