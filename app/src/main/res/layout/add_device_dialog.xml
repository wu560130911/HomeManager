<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/colorSurface"
    android:padding="20dp">

    <!-- 标题 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:text="@string/add_device"
        android:textColor="@color/neonBlue"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- 设备名称 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="@string/device_name"
        android:textColor="@color/colorOnSurfaceVariant"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/et_device_name"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/input_background"
        android:hint="例如：NAS服务器"
        android:inputType="text"
        android:maxLines="1"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textColor="@color/colorOnBackground"
        android:textColorHint="@color/colorOnSurfaceVariant"
        android:textSize="14sp" />

    <!-- MAC地址 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="@string/device_mac"
        android:textColor="@color/colorOnSurfaceVariant"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/et_device_mac"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/input_background"
        android:hint="例如：AA:BB:CC:DD:EE:FF"
        android:inputType="text"
        android:maxLines="1"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textColor="@color/colorOnBackground"
        android:textColorHint="@color/colorOnSurfaceVariant"
        android:textAllCaps="true"
        android:textSize="14sp" />

    <!-- 按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cancel"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="@string/cancel"
            android:textSize="14sp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:backgroundTint="@color/colorSurfaceVariant"
            android:textColor="@color/colorOnBackground"
            app:cornerRadius="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_save"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="@string/confirm"
            android:textSize="14sp"
            android:textStyle="bold"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:backgroundTint="@color/neonBlue"
            app:cornerRadius="8dp" />

    </LinearLayout>

</LinearLayout>
