<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 基础按钮样式 -->
    <style name="Widget.HomeManager.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.HomeManager.Button.Primary" parent="Widget.HomeManager.Button">
        <item name="backgroundTint">@color/neonBlue</item>
    </style>

    <style name="Widget.HomeManager.Button.Secondary" parent="Widget.HomeManager.Button">
        <item name="backgroundTint">@color/neonPurple</item>
    </style>

    <style name="Widget.HomeManager.Button.Danger" parent="Widget.HomeManager.Button">
        <item name="backgroundTint">@color/neonPink</item>
    </style>

    <style name="Widget.HomeManager.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/neonBlue</item>
        <item name="strokeColor">@color/neonBlue</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <!-- 输入框样式 -->
    <style name="Widget.HomeManager.TextInput.Outlined" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/neonBlue</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="hintTextColor">@color/colorOnSurfaceVariant</item>
        <item name="android:textColorHint">@color/colorOnSurfaceVariant</item>
    </style>

    <!-- 卡片样式 -->
    <style name="Widget.HomeManager.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/colorCard</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">#1AFFFFFF</item>
    </style>

    <!-- 文字样式 -->
    <style name="TextAppearance.HomeManager.Title" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textColor">@color/colorOnBackground</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.HomeManager.Body" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textColor">@color/colorOnSurface</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="TextAppearance.HomeManager.Caption" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textColor">@color/colorOnSurfaceVariant</item>
        <item name="android:textSize">12sp</item>
    </style>
</resources>
